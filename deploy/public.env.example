# 只保存在服务器 /etc/english-class/public.env；不发给学生。
DATABASE_PATH=/var/lib/english-class/class.sqlite3
# v0.3.4：学生自带API Key在SQLite中以Fernet密文保存。
# 留空时自动使用 DATABASE_PATH + .key；主密钥只给公共服务，文件0600。
# 可以指定独立绝对路径；在ProtectSystem=strict的只读目录下须提前放好原主密钥，
# 所有者english-public、权限0600。迁移路径时复制原文件，不能生成新key替代。
# 数据库与主密钥须分别备份；CLI/创建学生也必须使用同一路径。
# 详见 docs/verification/credential-storage.md。
LLM_SECRET_KEY_FILE=
DICTIONARY_PATH=/opt/english-class/data/dictionary.json
CLASS_TIMEZONE=Asia/Shanghai
PUBLIC_HOST=127.0.0.1
# 18080 在部署服务器上已被其他服务占用；修改时同步 nginx 和 create_student.sh 的 PUBLIC_URL。
PUBLIC_PORT=18090

# 官方名称当前为 deepseek-flash；使用中转时改成实际模型ID。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# 平台默认关闭thinking；家长自带模型按其thinking设置传入，不发送reasoning_effort。

# 默认本地Vosk；也可改为http并填写兼容转写接口，或tencent使用腾讯云一句话识别。
ASR_BACKEND=vosk
VOSK_EN_PATH=/opt/english-class/models/vosk-model-small-en-us-0.15
VOSK_ZH_PATH=/opt/english-class/models/vosk-model-small-cn-0.22
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
# 以下仅 http 模式生效。Qwen3-ASR 要求语言全名：en:English,zh:Chinese
ASR_LANGUAGE_MAP=
# vosk：云端失败/超时改用本机 Vosk，失败后 ASR_RETRY_AFTER 秒内直接走本机
ASR_FALLBACK=
# 云端识别调用上限（秒），不是单次读超时；可选本地回退另有下方上限
ASR_TIMEOUT=8
# 本地Vosk识别等待上限；每个公共服务进程最多同时处理4次识别（含云端/本地）
ASR_LOCAL_TIMEOUT=30
ASR_RETRY_AFTER=60
# 静音/持续噪声不送云端（云端会编出 "Okay."），按没听清处理；0 关闭。
# 有声帧须≥此音量且≥底噪2.5倍，连续60毫秒即算有人说话（短词也能通过）
ASR_MIN_RMS=200
# 仅 tencent 模式：腾讯云 API 密钥（建议用只授权语音识别的子账号），只放在公共服务器
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 沿用aibot的Edge语音路径；不可用时可配置兼容HTTP TTS。
TTS_BACKEND=edge
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_BASE_URL=
TTS_MODEL=
TTS_API_KEY=
TTS_VOICE=alloy

# 预生成听力素材。运行时只读，不在播放请求中调用模型或TTS。
LISTENING_DIR=/opt/english-class/data/listening

# 可选：探测Pi开机，空值禁用。只适用于当前一学生/一服务部署。
PI_SSH_HOST=
# 多学生时必须明确映射，避免把一台机器的在线状态套用到所有学生。
# PI_SSH_HOSTS={"s001":"pi-one","s002":"pi-two"}
PI_SSH_KEY=/etc/english-class/pi_ssh_key
PI_SSH_CONFIG=/etc/english-class/pi_ssh_config
PI_SSH_KNOWN_HOSTS=/var/lib/english-class/pi_known_hosts
