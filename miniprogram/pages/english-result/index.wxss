@import "../../utils/english-shared.wxss";
.summary .number { font-size: 60rpx; font-weight: 700; }
.summary .number text { font-size: 26rpx; color: #8A94A6; margin-left: 8rpx; }
.badge { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; }
.badge.state-0 { background: #EEF1F6; color: #5A6478; }
.badge.state-1 { background: #FBF3DF; color: #9A6B00; }
.badge.state-2 { background: #E7F7EC; color: #1F7A3D; }
.word-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.line { margin-top: 8rpx; }
.lesson-section { margin-top: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.lesson-card { margin-bottom: 12rpx; }
.lesson-status-in_progress { background: #FFF3D6; color: #996A00; }
.lesson-status-completed { background: #E7F7EC; color: #1F7A3D; }
.lesson-status-stopped { background: #EEF1F6; color: #5A6478; }
.review-status { margin-top: 8rpx; }
.review-segments { margin-top: 8rpx; padding: 10rpx 0; border-top: 1rpx solid #EEF1F6; }
