@import "../../utils/english-shared.wxss";
.time-row { display: flex; justify-content: space-between; }
.player-btns { display: flex; gap: 14rpx; margin: 10rpx 0; }
button.mini {
  flex: 1; font-size: 26rpx; padding: 0; margin: 0;
  background: #F2F5FA; color: #1C2333; border-radius: 14rpx; line-height: 72rpx; height: 72rpx;
}
button.mini.main { background: #2F6FED; color: #FFFFFF; }
.transcript { background: #F7F9FC; border-radius: 14rpx; padding: 18rpx; font-size: 26rpx; margin-top: 12rpx; white-space: pre-wrap; }
