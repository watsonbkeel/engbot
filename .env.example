# 英语口语陪练系统 - 配置模板
# 复制此文件为 .env 并填写真实值

# ========== 公共服务配置 (云端) ==========
DATABASE_PATH=/var/lib/english-class/class.sqlite3
LLM_SECRET_KEY_FILE=/var/lib/english-class/.key
DICTIONARY_PATH=/opt/english-class/data/dictionary.json
CLASS_TIMEZONE=Asia/Shanghai
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=9100

# 平台模型配置
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_API_KEY=your_llm_api_key_here

# ASR 语音识别
ASR_BACKEND=http
VOSK_EN_PATH=/opt/english-class/models/vosk-model-small-en-us-0.15
VOSK_ZH_PATH=/opt/english-class/models/vosk-model-small-cn-0.22
ASR_BASE_URL=http://your_asr_server:port/v1
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ASR_API_KEY=your_asr_api_key_here
ASR_LANGUAGE_MAP=en:English,zh:Chinese
ASR_FALLBACK=vosk
ASR_TIMEOUT=8
ASR_LOCAL_TIMEOUT=30
ASR_RETRY_AFTER=60
ASR_MIN_RMS=200

# TTS 语音合成
TTS_BACKEND=http
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_BASE_URL=http://your_tts_server:port
TTS_MODEL=piper
TTS_API_KEY=your_tts_api_key_here
TTS_VOICE=alloy

# 听力素材
LISTENING_DIR=/opt/english-class/data/listening

# ========== 学生脑端配置 (云端) ==========
STUDENT_ID=s001
PUBLIC_URL=https://your-domain.com
BRAIN_TOKEN=your_brain_token_here
EDGE_TOKEN=your_edge_token_here
BRAIN_HOST=0.0.0.0
BRAIN_PORT=9101
PRACTICE_WORDS=3
STUDENT_PROMPT_PATH=prompts/student.md

# ========== 树莓派边缘设备配置 ==========
BRAIN_URL=https://your-domain.com/students/s001
EDGE_TOKEN=your_edge_token_here
CAPTURE_DEVICE=plughw:CARD=Audio,DEV=0
PLAYBACK_DEVICE=plughw:CARD=Audio,DEV=0
VOSK_ZH_PATH=/opt/english-class-edge/models/vosk-model-small-cn-0.22
VAD_THRESHOLD=450
MIC_GAIN=1.0
ALLOW_INSECURE_HTTP=0
